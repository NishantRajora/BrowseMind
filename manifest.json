{
  "manifest_version": 3,
  "name": "BrowseMind",
  "version": "1.0.0",
  "description": "AI-powered contextual assistance for any web page.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
      }

  ],
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["**/*.js", "**/*.css", "**/*.html", "assets/icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
