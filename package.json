{
  "name": "browsemind",
  "version": "1.0.0",
  "description": "BrowseMind Chromium/Brave MV3 extension",
  "scripts": {
    "build": "npm run copy && esbuild src/**/*.ts --bundle --format=esm --outdir=dist --sourcemap",
    "copy": "cpx \"src/**/*.html\" dist && cpx \"src/**/*.css\" dist && cpx \"assets/**/*\" dist && cpx \"manifest.json\" dist",
    "test": "jest"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "cpx": "^1.5.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@types/chrome": "^0.0.167",
    "jest-environment-jsdom": "^29.0.0"
  },
  "dependencies": {}
}
